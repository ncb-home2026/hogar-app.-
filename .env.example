# Copiar este archivo a ".env" y completar los valores reales.
# NUNCA subir el archivo ".env" real a GitHub (ya está en .gitignore).

# Secreto para firmar los tokens de sesión (usar una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Token del túnel de Cloudflare (se obtiene al crear el túnel en el dashboard de Cloudflare)
TUNNEL_TOKEN=pegar-aqui-el-token-del-tunnel
